# --- required ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
POSTGRES_PASSWORD=archgraph

# Optional: Fernet key for integration credentials (derived from SECRET_KEY if unset)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- ports -----------------------------------------------------------------
WEB_PORT=8080
API_PORT=8000
MCP_PORT=8787
POSTGRES_PORT=5435

# --- behaviour -------------------------------------------------------------
ARCHGRAPH_ENV=production
DEMO_MODE=false
CORS_ORIGINS=*
# Allow cloning repositories from private network paths (self-hosted mirrors)
ALLOW_LOCAL_REPOS=true
ALLOW_PRIVATE_NETWORKS=false

# --- demo ------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@archgraph.io
DEMO_ADMIN_PASSWORD=archgraph-demo-2026
